# Copy to .env and fill in. NEVER commit .env or real keys.

# Deployer key — use a dedicated, low-value key for testnet.
PRIVATE_KEY=

# Where the initial supply is sent — USE A MULTISIG (Gnosis Safe).
RECIPIENT_ADDRESS=

# RPC endpoints (free tiers: Alchemy, Infura, or public defaults).
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Explorer API keys for source verification.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
